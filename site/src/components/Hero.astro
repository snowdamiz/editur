---
import DownloadButton from "./DownloadButton.astro";
import EditorMock from "./EditorMock.astro";
import { DOWNLOADS } from "../lib/downloads";
import { REPO } from "../lib/commands";
---

<section id="overview" class="relative pt-16 pb-8 md:pt-24 md:pb-16">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute top-[-10%] left-1/2 h-[520px] w-[720px] -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6">
    <p
      class="flex items-center gap-2 font-mono text-[12px] text-ink-2"
    >
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-40 motion-reduce:animate-none"></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      Continuous release · <strong class="font-medium text-ink">macOS, Windows, Linux</strong>
    </p>

    <h1
      class="mt-5 max-w-[16ch] text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.04em] text-ink md:text-7xl"
    >
      A small native editor for quick, <em class="font-serif font-normal text-ink italic">focused</em> file changes.
    </h1>

    <p
      class="mt-6 max-w-[54ch] text-lg leading-relaxed text-ink-2 md:text-xl"
    >
      Editur opens one file beside a lazy, keyboard-navigable tree, searches the project from a floating palette, and saves through conflict-checked atomic replacement. Nothing else is competing for the window.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <DownloadButton />
      <a
        href={REPO}
        class="inline-flex items-center gap-2 rounded-lg border border-line-2 bg-raised px-4 py-2.5 text-[15px] font-medium text-ink no-underline transition-colors hover:bg-ink/5"
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.68 7.68 0 0 1 8 3.5c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        View source
      </a>
    </div>
    <p data-download-detail class="mt-2 text-sm text-ink-3">
      {DOWNLOADS["macos-arm"].detail}
    </p>
    <p class="mt-3 text-[15px] text-ink-2">
      Prefer the shell?
      <a
        class="text-accent underline decoration-accent/40 underline-offset-2"
        href="#install"
      >
        Install from the terminal
      </a>
      instead.
    </p>

    <div class="mt-10 flex flex-wrap gap-2 border-t border-line pt-8">
      <span data-renderer="metal" class="chip inline-flex items-center gap-2 rounded-full border border-line bg-raised px-3 py-1.5 font-mono text-[11.5px] text-ink-2">
        <span class="chip-dot size-1.5 rounded-full bg-ink-3"></span>
        Metal · macOS
      </span>
      <span data-renderer="d3d12" class="chip inline-flex items-center gap-2 rounded-full border border-line bg-raised px-3 py-1.5 font-mono text-[11.5px] text-ink-2">
        <span class="chip-dot size-1.5 rounded-full bg-ink-3"></span>
        Direct3D 12 · Windows 10+
      </span>
      <span data-renderer="vulkan" class="chip inline-flex items-center gap-2 rounded-full border border-line bg-raised px-3 py-1.5 font-mono text-[11.5px] text-ink-2">
        <span class="chip-dot size-1.5 rounded-full bg-ink-3"></span>
        Vulkan 1.1 · Linux
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-dashed border-line bg-transparent px-3 py-1.5 font-mono text-[11.5px] text-ink-3">
        No wgpu, no runtime fallback
      </span>
    </div>

    <div class="mt-16 md:mt-20">
      <EditorMock />
    </div>
  </div>
</section>
