---
import Section from "./Section.astro";

const cells = [
  {
    key: "Ctrl+Space",
    title: "Completion",
    body: "Plain-text completion from the server, with hover documentation after the pointer rests.",
  },
  {
    key: "F8 · Shift+F8",
    title: "Diagnostics",
    body: "Walk to the next or previous diagnostic without leaving the keyboard.",
  },
  {
    key: "F12 · click",
    title: "Go to definition",
    body: "Jump straight to the definition, or open it in a split pane.",
  },
];
---

<Section
  id="lsp"
  index="lsp.toml"
  title="Language servers you already installed."
  lede="Editur never downloads a language server and never makes an LSP network request. It runs the binaries already on your PATH, lazily, per project."
>
  <div class="rise grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3" style="--i:3">
    {
      cells.map((cell) => (
        <div class="bg-editor p-6">
          <p class="font-mono text-[11px] text-accent">{cell.key}</p>
          <h3 class="mt-3 text-base font-semibold text-ink">{cell.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-2">{cell.body}</p>
        </div>
      ))
    }
  </div>

  <p class="rise mt-8 max-w-[62ch] text-sm leading-relaxed text-ink-3" style="--i:4">
    Presets cover rust-analyzer, TypeScript Language Server, Pyright, gopls, and clangd; each one can be left on Auto, pointed at a custom executable, or turned off. Servers stop when their last document closes, and files above 5 MiB never start one.
  </p>
</Section>
