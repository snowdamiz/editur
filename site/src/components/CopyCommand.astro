---
interface Props {
  command: string;
  id: string;
}

const { command, id } = Astro.props;
---

<div
  class="flex w-full min-w-0 max-w-full overflow-hidden rounded-lg border border-line bg-input shadow-(--shadow-lift)"
>
  <div
    class="flex min-w-0 flex-1 items-center gap-2.5 overflow-hidden px-3.5 py-2.5 font-mono text-[12.5px]"
  >
    <span class="shrink-0 text-accent" aria-hidden="true">$</span>
    <span id={id} data-command={command} class="min-w-0 flex-1 truncate">{command}</span>
  </div>
  <button
    class="copy-btn inline-flex shrink-0 items-center gap-1.5 border-l border-line bg-raised px-3.5 font-mono text-[11px] tracking-wide text-ink-2 transition-colors hover:bg-ink/5 hover:text-ink"
    type="button"
    data-copy={id}
  >
    <svg class="icon-copy size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor"></rect>
      <path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor"></path>
    </svg>
    <svg class="icon-check size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span>Copy</span>
  </button>
</div>
