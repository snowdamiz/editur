---
import CopyCommand from "./CopyCommand.astro";
import DownloadButton from "./DownloadButton.astro";
import { DOWNLOADS, DOWNLOAD_ORDER } from "../lib/downloads";
import { UNIX_INSTALL } from "../lib/commands";
---

<div class="grid min-w-0 gap-8 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:gap-10">
  <div class="min-w-0">
    <p class="font-mono text-[11px] font-medium tracking-[0.14em] text-accent uppercase">
      Download
    </p>
    <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink">Get the native build</h3>
    <p class="mt-2 text-[15px] leading-relaxed text-ink-2">
      A checksummed <code class="text-ink-2">Editur.app</code> archive from the continuous macOS release.
    </p>
    <div class="mt-5">
      <DownloadButton />
    </div>
    <p data-download-detail class="mt-2 text-sm text-ink-3">
      {DOWNLOADS["macos-arm"].detail}
    </p>
    <div class="mt-4 flex flex-wrap gap-1" role="group" aria-label="Download platform">
      {
        DOWNLOAD_ORDER.map((id) => {
          const spec = DOWNLOADS[id];
          return (
            <a
              href={spec.href}
              data-download-option={id}
              data-label={spec.label}
              data-detail={spec.detail}
              aria-label={spec.label}
              aria-current={id === "macos-arm" ? "true" : undefined}
              class="rounded-md border border-transparent px-2.5 py-1 font-mono text-[11px] text-ink-3 no-underline transition-colors hover:text-ink aria-[current=true]:border-line-2 aria-[current=true]:bg-raised aria-[current=true]:text-ink"
            >
              {spec.option}
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="flex items-center gap-3 lg:flex-col lg:justify-center lg:px-2" aria-hidden="true">
    <span class="h-px flex-1 bg-line lg:h-16 lg:w-px lg:flex-none"></span>
    <span class="font-mono text-[11px] tracking-[0.14em] text-ink-3 uppercase">or</span>
    <span class="h-px flex-1 bg-line lg:h-16 lg:w-px lg:flex-none"></span>
  </div>

  <div class="min-w-0">
    <p class="font-mono text-[11px] font-medium tracking-[0.14em] text-accent uppercase">
      Terminal
    </p>
    <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink">Install from the terminal</h3>
    <p class="mt-2 text-[15px] leading-relaxed text-ink-2">
      One line that verifies the SHA-256 checksum, then installs the same release the download uses.
    </p>
    <div class="mt-5 min-w-0">
      <CopyCommand command={UNIX_INSTALL} id="cta-cmd" />
    </div>
    <p class="mt-3 min-w-0 text-sm break-words text-ink-3">
      Full steps in <a class="text-accent underline decoration-accent/40 underline-offset-2" href="#install">Install</a>.
    </p>
  </div>
</div>
